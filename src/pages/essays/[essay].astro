---
import { getEntries, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TopicChips from '../../components/TopicChips.astro';
import { formatDate, getEssays } from '../../lib/site';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay) => ({ params: { essay: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const topics = await getEntries(essay.data.topics);
---

<Layout title={essay.data.title} description={essay.data.description}>
  <article class="mx-auto max-w-2xl">
    <header class="mb-10 flex flex-col gap-4">
      <time datetime={essay.data.published.toISOString()} class="text-sm text-muted">
        {formatDate(essay.data.published)}
      </time>
      <h1 class="font-display text-4xl leading-tight font-extrabold tracking-tight sm:text-5xl">{essay.data.title}</h1>
      <p class="text-xl text-muted">{essay.data.description}</p>
      <TopicChips topics={topics} size="md" />
    </header>
    <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:tracking-tight prose-a:text-accent">
      <Content />
    </div>
  </article>
</Layout>
