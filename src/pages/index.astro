---
import Layout from '../layouts/Layout.astro';
import { getEssays, essayUrl } from '../lib/site';

const essays = await getEssays();
---

<Layout>
  <section class="flex flex-col gap-6">
    <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">AI for Developers</h1>
    <p class="text-xl text-muted">Essays on building software with autonomous AI agents.</p>
    <div class="mt-8 flex flex-col gap-4">
      <h2 class="font-display text-2xl font-bold">Essays</h2>
      <ul class="flex flex-col gap-2">
        {
          essays.map((essay) => (
            <li>
              <a href={essayUrl(essay.id)} class="text-lg font-medium text-ink hover:text-accent">
                {essay.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
